rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isParentOf(patientId) {
      return exists(/databases/$(database)/documents/parents/$(request.auth.uid))
             && get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedPatientId == patientId;
    }

    // Patients — allow create pour tout utilisateur connecté
    match /patients/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isParentOf(userId));
      // CREATION : autoriser si l'uid du document = uid connecté
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      // MODIFICATION : idem
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      match /rappels/{rappelId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId || isParentOf(userId));
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Parents
    match /parents/{parentId} {
      allow read, write: if request.auth != null && request.auth.uid == parentId;
    }

    // Annuaire minimal (email -> uid/role) — permet de retrouver un compte
    // par email (lien parent/patient, futur lien patient/medecin) sans
    // exposer les dossiers complets. Ne contient QUE uid, email, role.
    // Lecture publique necessaire : un parent doit pouvoir chercher le
    // patient AVANT d'avoir son propre compte (donc avant d'etre authentifie).
    match /lookups/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Médecins
    // Lecture publique necessaire : le selecteur de medecin (inscription
    // patient) doit pouvoir lister les medecins AVANT que le patient ait
    // un compte, donc avant d'etre authentifie.
    match /doctors/{doctorId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.uid == doctorId;
      // Le medecin peut modifier tout son profil ; n'importe quel autre
      // utilisateur authentifie peut UNIQUEMENT incrementer patientCount
      // (necessaire quand un patient se lie a ce medecin depuis son
      // propre formulaire d'inscription — ce n'est pas le medecin qui
      // ecrit dans ce cas, donc auth.uid != doctorId).
      allow update: if request.auth != null && (
        request.auth.uid == doctorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientCount'])
      );
    }

    // Rappels médecin
    match /doctorReminders/{reminderId} {
      allow read: if request.auth != null
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.doctorId == request.auth.uid
                      || isParentOf(resource.data.patientId));
      allow create: if request.auth != null
                    && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.doctorId == request.auth.uid;
    }

    // Ordonnances
    match /ordonnances/{ordonnanceId} {
      allow read: if request.auth != null
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.doctorId == request.auth.uid
                      || isParentOf(resource.data.patientId));
      allow create: if request.auth != null
                    && request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.doctorId == request.auth.uid;
    }

    // Rendez-vous
    match /rdvs/{rdvId} {
      allow read: if request.auth != null
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.doctorId == request.auth.uid
                      || isParentOf(resource.data.patientId));
      allow create: if request.auth != null
                    && (request.resource.data.patientId == request.auth.uid
                        || request.resource.data.doctorId == request.auth.uid);
      allow update, delete: if request.auth != null
                    && (resource.data.patientId == request.auth.uid
                        || resource.data.doctorId == request.auth.uid);
    }

    // Messages
    match /messages/{messageId} {
      allow read: if request.auth != null
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.doctorId == request.auth.uid);
      allow create: if request.auth != null
                    && (request.resource.data.patientId == request.auth.uid
                        || request.resource.data.doctorId == request.auth.uid);
    }

    // Forum
    match /forum/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['likes', 'likedBy']);
      allow delete: if request.auth != null
                    && resource.data.from == request.auth.uid;
    }
  }
}
